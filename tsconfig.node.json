{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
		"lib": ["ES2023"],
		"types": ["node"],

		"module": "nodenext",
		"moduleResolution": "nodenext",
		"noImplicitAny": false,
		"useUnknownInCatchVariables": false
	},
	"include": ["config/**/*.mts", "scripts/**/*.mts", "vite.config.ts"]
}

{
	"name": "portfolio",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"packageManager": "pnpm@11.13.1",
	"scripts": {
		"dev": "vite",
		"build": "pnpm refresh && pnpm build:static",
		"build:static": "tsc -b && pnpm build:client && pnpm build:server && pnpm prerender",
		"build:client": "vite build",
		"build:server": "vite build --ssr app/server/entry.tsx --outDir dist/server",
		"prerender": "node scripts/prerender.mjs",
		"refresh": "node scripts/refresh.mjs",
		"test": "node --import ./scripts/register-aliases.mjs --experimental-strip-types --test",
		"test:browser": "playwright test",
		"check:production-budget": "node scripts/production-budget.mjs",
		"report:production-budget": "pnpm build && node scripts/production-budget.mjs --write-report",
		"verify:production": "pnpm validate && pnpm test:browser && pnpm check:production-budget",
		"verify:cloudflare": "node scripts/verify-cloudflare-deployment.mjs",
		"preview": "vite preview",
		"typecheck": "tsc -b --pretty false",
		"lint": "biome lint .",
		"format": "biome format --write .",
		"check": "biome check .",
		"check:write": "biome check --write .",
		"validate": "pnpm typecheck && pnpm check && pnpm test && pnpm build"
	},
	"dependencies": {
		"react": "^19.2.7",
		"react-dom": "^19.2.7"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.4",
		"@playwright/test": "^1.61.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^24.13.2",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.0.3",
		"tailwindcss": "^4.3.3",
		"typescript": "~6.0.2",
		"vite": "^8.1.1"
	}
}
